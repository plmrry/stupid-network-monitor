{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "lib": ["ESNext"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.tsbuildinfo"
  },
  "exclude": ["node_modules"],
  "include": [
    "**/*.mjs",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "forge.config.ts",
    "src/main.mjs",
    "src/speed-test.mjs"
  ]
}
