{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "app:dev": {
      "cache": false,
      "persistent": true
    },
    "app:package": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "app:typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
